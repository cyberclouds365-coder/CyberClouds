# Local API. Render sets PORT automatically in production.
PORT=3000

# Persistent PostgreSQL. Leave blank only for local in-memory preview.
DATABASE_URL=

# Persistent, private server secret for signup verification (64+ chars in production).
JWT_SECRET=
# Set real administrator credentials in your environment; never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The public Netlify URL used in account emails.
APP_URL=http://localhost:5173

# Brevo SMTP settings. Use your actual account and verified sender.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=
